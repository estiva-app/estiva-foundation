{
  "name": "@estiva-app/hello",
  "version": "0.0.1",
  "description": "Throwaway package proving the Estiva publish pipeline end to end. Not a library \u2014 do not depend on it.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estiva-app/estiva-foundation.git",
    "directory": "packages/hello"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
